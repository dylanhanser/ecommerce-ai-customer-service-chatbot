      "forbidden_elements": [
        "冒充真人客服"
      ]
    },
    {
      "case_id": "B010",
      "category": "identity_handover",
      "user_input": "别给我自动回复了，我就找人工，给我转一下。",
      "expected_action_type": "human_handover",
      "retrieval_expected": false,
      "required_elements": [
