      "forbidden_elements": [
        "擅自判断订单状态",
        "声称已经处理"
      ]
    },
    {
      "case_id": "B017",
      "category": "normal_control",
      "user_input": "你们店平时是固定一家快递，还是看仓库安排啊？",
