        "虚构具体到账状态"
      ]
    },
    {
      "case_id": "B019",
      "category": "normal_control",
      "user_input": "我想换大一码，一般在订单里咋申请、怎么寄回去啊？",
      "expected_action_type": "rag_answer",
      "retrieval_expected": true,
      "required_elements": [
