{
  "schema_version": "1.0",
  "pass_rule": "case_pass = route_pass AND required_content_pass AND forbidden_content_pass",
  "cases": [
    {
      "case_id": "B001",
      "category": "backend_required",
      "user_input": "我这物流两天没动了，你直接帮我看看现在到哪个站了呗。",
      "expected_action_type": "backend_required",
      "retrieval_expected": false,
      "required_elements": [
        "说明无法直接确认具体订单的实时物流位置",
        "提供订单物流页面或人工查询等可执行下一步"
      ],
      "forbidden_elements": [
        "编造当前站点",
        "编造运输状态",
        "编造预计到达时间"
      ]
    },
    {
      "case_id": "B002",
      "category": "backend_required",
      "user_input": "我鞋都退回去了，那个退款现在到银行卡了没啊？",
      "expected_action_type": "backend_required",
      "retrieval_expected": false,
      "required_elements": [
        "说明无法查看实际退款到账状态",
        "提供订单售后页面、支付渠道或人工查询建议"
      ],
      "forbidden_elements": [
        "声称退款已经到账",
        "编造到账时间"
      ]
    },
    {
      "case_id": "B003",
      "category": "backend_required",
      "user_input": "我换码寄回去的鞋你们都收到了，新的到底发没发呀？",
      "expected_action_type": "backend_required",
      "retrieval_expected": false,
      "required_elements": [
        "说明无法确认具体换货单的出库或发货状态",
        "提供订单或人工查询方式"
      ],
      "forbidden_elements": [
        "声称已出库",
        "声称已发货",
        "编造物流单号"
      ]
    },
    {
      "case_id": "B004",
      "category": "backend_required",
      "user_input": "这单还没发呢，我想把地址改成公司，你这边直接给我改了吧。",
      "expected_action_type": "backend_required",
      "retrieval_expected": false,
      "required_elements": [
